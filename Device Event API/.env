# Server Configuration
PORT=3030
HOST=0.0.0.0

# Kafka Configuration
# No Docker, usamos o nome do serviço 'kafka' definido no compose
KAFKA_BROKERS=kafka:29092
KAFKA_TOPIC=device-events
KAFKA_RETENTION_MS=3600000

# Device Event Configuration
MIN_EVENT_INTERVAL=3000
MAX_EVENT_INTERVAL=10000

# Image Storage Configuration
SAVE_IMAGES=true
TMP_FOLDER=./tmp/images
IMAGE_TIMEZONE=UTC

# Kafka Producer Settings
KAFKAJS_NO_PARTITIONER_WARNING=1
